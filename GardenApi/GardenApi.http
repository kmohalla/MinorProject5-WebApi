Content-Type: application/json

{
    "toolWeightMetricKg": 0,
    "toolWeightImperialLbs": 0.5511550,
    "toolName": "Trowel2",
    "material": "Stainless Steel",
    "toolLengthMetricCm": 30,
    "toolLengthImperialIn": 11
  }

