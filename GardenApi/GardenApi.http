@GardenApi_HostAddress = https://localhost:7212


// defaault API endpoint
GET {{GardenApi_HostAddress}}/weatherforecast/
Accept: application/json

###

//
//Gardenbeds--standard behavior
GET {{GardenApi_HostAddress}}/api/gardenbeds

###

//erroralways returns bed 1?--fixed. used incorrect overriding method for id field
//@id=5
//GET {{GardenApi_HostAddress}}/api/gardenbeds/{{id}}
GET {{GardenApi_HostAddress}}/api/gardenbeds/5

###
POST {{GardenApi_HostAddress}}/api/gardenbeds
Content-Type: application/json

{
  "BedName": "new bed",
  "BedState": "Planned",
  "DatePlanted": "2026-05-28T00:00:00",
  "GuideTitle": "Tomatoes from Seed",
  "PlantName": "Sungold Tomato",
  "ToolName": "Trowel"

}

###

@id=3
PUT {{GardenApi_HostAddress}}/api/gardenbeds/3
Content-Type: application/json

{
  "id": 3,
  "BedName": "Front Walk Flowers-edited",
  "BedState": "Harvested",
  "DatePlanted": "2026-05-28T00:00:00",
  "GuideTitle": "Cut-Flower Border",
  "PlantName": "Zinnia State Fair",
  "ToolName": "Hand Cultivator"
}

###

@id=7
DELETE {{GardenApi_HostAddress}}/api/gardenbeds/7

###

//Gardenbeds--business logic testing
//status in expected list: Planned, Growing, Harvested
POST {{GardenApi_HostAddress}}/api/gardenbeds
Content-Type: application/json

{
  "BedName": "new bed2",
  "BedState": "not legit",
  "DatePlanted": "2027-05-15T00:00:00",
  "GuideTitle": "Tomatoes from Seed",
  "PlantName": "Sungold Tomato",
  "ToolName": "Trowel"

}
###
//date for growing and harvested in the past, not future
POST {{GardenApi_HostAddress}}/api/gardenbeds
Content-Type: application/json

{
  "BedName": "new bed3",
  "BedState": "Growing",
  "DatePlanted": "2027-05-15T00:00:00",
  "GuideTitle": "Tomatoes from Seed",
  "PlantName": "Sungold Tomato",
  "ToolName": "Trowel"

}

